# Configuração do alfred. O iniciar.sh copia este arquivo para alfred.conf na
# primeira vez; edite o alfred.conf. Variáveis já definidas no ambiente vencem
# o arquivo (ex.: ALFRED_MODELO=opus ./iniciar.sh).

# Modelo padrão: opus, sonnet, haiku ou um nome completo (claude-opus-5-5,
# claude-sonnet-5-5, claude-haiku-5-5, claude-fable-5-1) vão ao Claude Code;
# um modelo do Codex (GPT-6.2-Sol, GPT-6.2-Astra, GPT-6.1-Terra, GPT-6-Luna…,
# em qualquer caixa, ou codex:<slug>) vai ao Codex.
# Vazio = o padrão do CLI. Um cliente pode pedir outro modelo no campo "model".
ALFRED_MODELO=sonnet

# Quanto o modelo pensa: low, medium, high, xhigh, max. Vazio = padrão do CLI.
# O cliente pode pedir outro por chamada (campo "reasoning_effort").
ALFRED_ESFORCO=

# Onde escutar, separado por vírgula:
#   127.0.0.1:8765    qualquer programa local
#   172.31.87.1:8765  a rede Docker do Treino IA (~/job/exercicio). Só existe
#                     com o app no ar; até lá o alfred espera por ela sozinho.
#   172.31.88.1:8765  a rede Docker do Tifon (driver de IA `alfred`). Mesma
#                     coisa: só existe com o Tifon no ar.
ALFRED_ADDR=127.0.0.1:8765,172.31.87.1:8765,172.31.88.1:8765

# Chamadas ao claude ao mesmo tempo.
ALFRED_PARALELAS=2

# Token opcional: com ele, todo POST precisa de "Authorization: Bearer <token>".
# O analista não manda token; se ligar, configure o cabeçalho nele também.
ALFRED_TOKEN=

# Caminho do CLI do Claude Code (vazio = "claude" do PATH).
ALFRED_CLAUDE=

# Caminho do CLI do Codex, usado quando o modelo é GPT-… (vazio = "codex" do
# PATH ou o que o app do Codex instala em ~/.codex/packages/…/current/codex).
ALFRED_CODEX=

# Fotos e vídeos. Vídeo vira N quadros (o cliente pode pedir outro número com
# "video_quadros"); foto grande ou em formato que o Claude não lê é convertida.
# As duas coisas usam o ffmpeg (vazio = "ffmpeg" do PATH).
ALFRED_FFMPEG=
ALFRED_QUADROS_VIDEO=8
# Teto de um pedido em MB, contando fotos e vídeos em base64.
ALFRED_MAX_CORPO_MB=64

# Quanto um pedido longo (que virou ticket) pode rodar, em segundos (padrão 1800).
ALFRED_JOB_TETO=1800
